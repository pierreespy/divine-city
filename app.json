{
  "expo": {
    "name": "Divine City",
    "slug": "divine-city",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12141c",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pierreespy.divinecity"
    },
    "android": {
      "package": "com.pierreespy.divinecity",
      "adaptiveIcon": {
        "backgroundColor": "#12141c"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#77b9e5",
          "ios": {
            "image": "./assets/chargement.jpg",
            "imageWidth": 688,
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "image": "./assets/ui/laurier.png",
            "imageWidth": 120,
            "backgroundColor": "#77b9e5",
            "resizeMode": "contain"
          }
        }
      ],
      "expo-asset"
    ]
  }
}
